<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>PBAndJ.Mod</RootNamespace>
    <VendorDir>$(MSBuildThisFileDirectory)../../vendor/Managed</VendorDir>
  </PropertyGroup>
  <!--
    The drive channel is a loopback command socket that can run any console
    command, and Quantum Console's Extras assembly already registers `exec`
    (compile and run arbitrary C#), file read/write and HTTP. That is remote code
    execution, and no runtime flag is a strong enough guarantee against it
    reaching a published build — an environment variable is one launch option
    away from being set by anyone.

    So the rig is a COMPILE-TIME opt-in. Without -p:PbjDrive=true the socket, its
    pump and its console commands are not in the assembly at all, and
    `make check-no-drive-channel` proves it against the built DLL before anything
    ships. `make deploy` sets it; `make package` refuses to run with it set.
  -->
  <PropertyGroup Condition="'$(PbjDrive)' == 'true'">
    <DefineConstants>$(DefineConstants);PBJ_DRIVE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <ProjectReference Include="../PBAndJ.Core/PBAndJ.Core.csproj" />
    <ProjectReference Include="../PBAndJ.Net/PBAndJ.Net.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(VendorDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      NGUI. UIInput, UILabel, UIWidget and UIPanel are defined here rather than
      in Assembly-CSharp, so the connect screen (M10c) cannot compile without it.
      See docs/notes/ngui-surface.md — decompile this one too before touching UI,
      or the API is being guessed at.
    -->
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(VendorDir)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VendorDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(VendorDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(VendorDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The connect screen: Input for the Escape key, BoxCollider for sizing a
         cloned field's click target. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(VendorDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(VendorDir)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- M8's playback driver. Silencing a unit's idle animation before writing
         its recorded bones means touching Animator.enabled, and Animator lives
         here rather than in CoreModule. -->
    <!-- For reading particleCount when measuring whether a replayed effect
         actually drew anything. The type is forwarded out of UnityEngine.dll,
         so it is unreachable without this even though the code compiles
         against UnityEngine elsewhere. -->
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(VendorDir)/UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(VendorDir)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Entitas">
      <HintPath>$(VendorDir)/Entitas.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="QFSW.QC">
      <HintPath>$(VendorDir)/QFSW.QC.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      The update check. UnityWebRequest rather than HttpWebRequest because the
      game already proves that path works under Proton — its crash reporter
      POSTs over HTTPS the same way — whereas Mono's own TLS stack under Wine is
      an unknown nobody has tested here.
    -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(VendorDir)/UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VendorDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
