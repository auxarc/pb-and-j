<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>PBAndJ.Mod</RootNamespace>
    <VendorDir>$(MSBuildThisFileDirectory)../../vendor/Managed</VendorDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <ProjectReference Include="../PBAndJ.Core/PBAndJ.Core.csproj" />
    <ProjectReference Include="../PBAndJ.Net/PBAndJ.Net.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(VendorDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      NGUI. UIInput, UILabel, UIWidget and UIPanel are defined here rather than
      in Assembly-CSharp, so the connect screen (M10c) cannot compile without it.
      See docs/notes/ngui-surface.md — decompile this one too before touching UI,
      or the API is being guessed at.
    -->
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(VendorDir)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VendorDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(VendorDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(VendorDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The connect screen: Input for the Escape key, BoxCollider for sizing a
         cloned field's click target. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(VendorDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(VendorDir)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Entitas">
      <HintPath>$(VendorDir)/Entitas.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="QFSW.QC">
      <HintPath>$(VendorDir)/QFSW.QC.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      The update check. UnityWebRequest rather than HttpWebRequest because the
      game already proves that path works under Proton — its crash reporter
      POSTs over HTTPS the same way — whereas Mono's own TLS stack under Wine is
      an unknown nobody has tested here.
    -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(VendorDir)/UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VendorDir)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
